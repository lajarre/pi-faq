{
  "name": "pi-faq",
  "version": "0.2.0",
  "description": "Knowledge capture to a configured faq/ref knowledgebase",
  "author": "lajarre",
  "license": "MIT",
  "keywords": ["pi-package"],
  "repository": {
    "type": "git",
    "url": "https://github.com/lajarre/pi-faq.git"
  },
  "files": [
    "extensions/",
    "internal/",
    "skills/",
    "prompts/",
    "script/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "migrate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/migrate-docs.ts",
    "validate-provenance": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/validate-provenance.ts"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  }
}
